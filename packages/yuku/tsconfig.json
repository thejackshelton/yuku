{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "allowJs": false,
    "allowImportingTsExtensions": false,
    "erasableSyntaxOnly": true,
    "isolatedDeclarations": true,
    "declaration": true,
    "stripInternal": true,
    "paths": { "#module": ["./core/module/loader.d.ts"] }
  },
  "include": ["core", "parser", "analyzer", "ast", "codegen", "types"],
  "exclude": []
}
